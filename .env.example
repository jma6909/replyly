# Neon: copy the connection string from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string (run: openssl rand -hex 32)
AUTH_SECRET=change-me

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Stripe keys (use sk_test_ while building, sk_live_ for the real $1 charge)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price in cents for the monthly plan. 100 = $1 (good for the live proof charge)
PRICE_CENTS=100

# Your public URL (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
